{
  "name": "fathom-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node ../tools/generate-fathom-theme.mjs",
    "brand": "node ../tools/generate-fathom-theme.mjs && node ../assets/brand/build-brand.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "node ../tools/generate-fathom-theme.mjs --check && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
